# v3 workers 环境模板（D5 已确认：现在提供；当前 CI provider=airflow，Jenkins 预留）
# 用法：cp .env.example .env && chmod 600 .env；.env 不入 git。
# 秘密值（token/PAT/API key/密码）由用户自行填入 .env，不要贴进会话、代码或日志。

# --- chassis（并行期分区契约值）---
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=iqe-v3

# --- 护栏默认（G1/G2 预算）---
IQE_EXECUTION_MODE=dry_run
IQE_CI_ALLOWLIST=
IQE_MAX_RERUNS=2
IQE_TIMEOUT_MINUTES=30
IQE_HOURLY_RERUN_CAP=10
IQE_MAX_REWORK=1
IQE_HISTORY_REUSE=off
CI_PROVIDER=airflow
# G8 摄入 admission：source 白名单 + 每小时摄入上限
IQE_SOURCE_ALLOWLIST=simulator,monitor
IQE_INGEST_HOURLY_CAP=60

# --- Airflow（当前 CI provider；API v2，POST /auth/token 换 JWT）---
AIRFLOW_BASE_URL=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
# 首批 allowlist：1 条测试 DAG（填入 IQE_CI_ALLOWLIST）+ 一个已知失败 dag_run（M2 真实读 / M4 live 验收用）
IQE_KNOWN_FAILED_REF=

# --- Jira / Azure：当前无真实系统时 IQE_TICKET_SINK=mock；接真实系统前必须改 live 并填齐凭据（需用户确认）---
IQE_TICKET_SINK=mock
JIRA_BASE_URL=
JIRA_USER=
JIRA_TOKEN=
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PAT=

# --- 每角色模型端点（Strix Halo：local vLLM / qoder-proxy / 云可切换；M1 dry-run 不接 LLM）---
ROUTER_MODEL_BASE_URL=http://127.0.0.1:3000/v1
ROUTER_MODEL_API_KEY=
ROUTER_MODEL_ID=deepseek-v4-flash
TRIAGE_MODEL_BASE_URL=http://127.0.0.1:3000/v1
TRIAGE_MODEL_API_KEY=
TRIAGE_MODEL_ID=deepseek-v4-flash
REPRO_MODEL_BASE_URL=http://127.0.0.1:3000/v1
REPRO_MODEL_API_KEY=
REPRO_MODEL_ID=deepseek-v4-flash
TICKET_MODEL_BASE_URL=http://127.0.0.1:3000/v1
TICKET_MODEL_API_KEY=
TICKET_MODEL_ID=deepseek-v4-flash
REVIEW_MODEL_BASE_URL=http://127.0.0.1:3000/v1
REVIEW_MODEL_API_KEY=
REVIEW_MODEL_ID=deepseek-v4-pro
REPORTING_MODEL_BASE_URL=http://127.0.0.1:3000/v1
REPORTING_MODEL_API_KEY=
REPORTING_MODEL_ID=deepseek-v4-flash