{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iqe-v3/case-input",
  "type": "object",
  "required": ["schema_version", "incident_id", "source", "ci", "issued_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "3.0" },
    "incident_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "ci": {
      "type": "object",
      "required": ["provider", "base_url", "run_ref", "failed_tasks"],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["airflow", "jenkins"] },
        "base_url": { "type": "string" },
        "dag_id": { "type": "string" },
        "job_id": { "type": "string" },
        "run_ref": { "type": "string" },
        "failed_tasks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "signature": { "type": "string" },
    "evidence_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_urls": { "type": "array", "items": { "type": "string" } },
        "pr": { "type": "string" },
        "config_rev": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_reruns": { "type": "integer", "minimum": 0, "maximum": 5 },
        "timeout_minutes": { "type": "number", "minimum": 0.1, "maximum": 240 },
        "hourly_rerun_cap": { "type": "integer", "minimum": 0 }
      }
    },
    "dry_run_scenario": {
      "enum": ["stable_fail", "flaky", "all_pass", "paused", "timeout"]
    },
    "issued_at": { "type": "string" }
  }
}